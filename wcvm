class Host:
    """This computer and its QEMU: what they can do, each asked once."""

    def __init__(self):
        self.system = platform.system()
        self.qemu = os.environ.get("WCVM_QEMU") or shutil.which("qemu-system-x86_64")
        self.qemu_img = os.environ.get("WCVM_QEMU_IMG") or shutil.which("qemu-img")
        self._lists = {}

    def names(self, option):
        """What QEMU lists for -OPTION help: devices, displays, accelerators..."""
        if option not in self._lists:
            text = ""
            if self.qemu:
                try:
                    text = subprocess.run([self.qemu, "-" + option, "help"], stdin=subprocess.DEVNULL,
                                          capture_output=True, text=True, timeout=60).stdout
                except (OSError, subprocess.SubprocessError):
                    pass
            if option == "device":
                self._lists[option] = set(re.findall(r'^name "([^"]+)"', text, re.M))
            else:
                self._lists[option] = set(line.strip() for line in text.splitlines()[1:] if line.strip())
        return self._lists[option]

    @cached_property
    def version(self):
        try:
            out = subprocess.run([self.qemu, "--version"], stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=60).stdout
            m = re.search(r"version (\d+)\.(\d+)(?:\.(\d+))?", out)
            return tuple(int(x or 0) for x in m.groups())
        except (OSError, subprocess.SubprocessError, AttributeError, TypeError):
            return None

    @cached_property
    def accel(self):
        accels = self.names("accel")
        if self.system == "Linux" and "kvm" in accels and os.access("/dev/kvm", os.R_OK | os.W_OK):
            return "kvm"
        if self.system == "Darwin" and "hvf" in accels and platform.machine() == "x86_64":
            return "hvf"
        return "tcg"

    @cached_property
    def window(self):
        """QEMU's display for a window on this screen, or None."""
        displays = self.names("display")
        if self.system == "Darwin":
            return "cocoa" if "cocoa" in displays else None
        if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
            return None
        return next((d for d in ("gtk", "sdl") if d in displays), None)

    @cached_property
    def gl_problem(self):
        """Why the VM cannot have 3D graphics here, or None when it can."""
        if self.window not in ("gtk", "sdl"):
            return "it needs a GTK or SDL window"
        if "virtio-vga-gl" not in self.names("device"):
            return "QEMU lacks its OpenGL display device (virtio-vga-gl)"
        if not glob.glob("/dev/dri/renderD*"):
            return "this computer has no GPU render node (/dev/dri/renderD*)"
        return None

    @cached_property
    def audio(self):
        drivers = self.names("audiodev")
        if self.system == "Darwin":
            return "coreaudio" if "coreaudio" in drivers else None
        runtime = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
        if "pa" in drivers and os.path.exists(os.path.join(runtime, "pulse", "native")):
            return "pa"
        if "pipewire" in drivers and os.path.exists(os.path.join(runtime, "pipewire-0")):
            return "pipewire"
        return None

    @cached_property
    def uefi(self):
        """(code, variables template, format) of a UEFI firmware for a q35
        machine without Secure Boot, from QEMU's firmware descriptors, or None."""
        if os.environ.get("WCVM_UEFI_CODE") and os.environ.get("WCVM_UEFI_VARS"):
            return os.environ["WCVM_UEFI_CODE"], os.environ["WCVM_UEFI_VARS"], "raw"
        dirs = ["/etc/qemu/firmware", "/usr/share/qemu/firmware",
                os.path.expanduser("~/.config/qemu/firmware")]
        if self.qemu:
            dirs.append(os.path.join(os.path.dirname(os.path.realpath(self.qemu)),
                                     "..", "share", "qemu", "firmware"))
        unwanted = {"secure-boot", "requires-smm", "amd-sev", "amd-sev-es", "amd-sev-snp", "intel-tdx"}
        found = []
        for d in dirs:
            for path in glob.glob(os.path.join(d, "*.json")):
                try:
                    with open(path) as f:
                        fw = json.load(f)
                    m = fw["mapping"]
                    if ("uefi" not in fw.get("interface-types", []) or m.get("device") != "flash"
                            or m.get("mode", "split") != "split" or unwanted & set(fw.get("features", []))
                            or not any(t.get("architecture") == "x86_64" and
                                       any(fnmatch.fnmatch("pc-q35-9.0", p) for p in t.get("machines", []))
                                       for t in fw.get("targets", []))):
                        continue
                    code, tmpl = m["executable"], m["nvram-template"]
                    if os.path.isfile(code["filename"]) and os.path.isfile(tmpl["filename"]):
                        found.append((os.path.basename(path), code["filename"], tmpl["filename"],
                                      code.get("format", "raw")))
                except (OSError, ValueError, KeyError, TypeError, AttributeError):
                    continue
        if found:
            return min(found)[1:]           # descriptors rank themselves by name
        for code, tmpl in KNOWN_UEFI:
