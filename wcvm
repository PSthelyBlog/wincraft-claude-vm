def remember(cfg, info):
    """An installed system running from the disk: say so in the settings
    (also after the person installed it with the installer window)."""
    if info and info.get("session") == "installed" and info.get("version") and \
            (not cfg["installed"] or cfg["installed_version"] != info["version"]):
        cfg.update(installed=True, installed_version=info["version"])
        save_config(cfg)


def guest_request(helper, args, timeout, show=True):
    """Ask wcinit for one of WinCraft's privileged helpers, the way its
    windows do, with a request of our own; print its progress lines; return
    them all once the last one says how it ended."""
    req = os.urandom(8).hex()
    out, ok, status = serial_sh("/usr/bin/wcctl priv %s request=%s %s" % (helper, req, args), 15)
    if not ok or status:
        die("WinCraft OS's system service could not be asked: %s" % out.strip())
    start, shown = time.time(), 0
    while time.time() - start < timeout:
        time.sleep(2)
        out, ok, status = serial_sh("cat /run/wincraft/requests/%s" % req, 15)
        if not ok or status:
            if time.time() - start > 15:
                die("WinCraft OS's system service did not respond")
            continue
        lines = out.splitlines()
        if show and len(lines) > shown:
            new = lines[shown:]
            # of the download's progress lines, the newest is enough
            for i, line in enumerate(new):
                if not (re.search(r": \d+ of \d+ MB$", line) and i < len(new) - 1):
                    say("  " + line)
        shown = len(lines)
        if lines and (lines[-1] in ("done", "checked") or lines[-1].startswith("error: ")):
            return lines
    die("the %s helper did not finish within %d seconds" % (helper, timeout))


def guest_path(path):
    """A path in the VM; Windows paths (C:\\..., Z:\\..., H:\\...) are turned into the Linux ones."""
    m = re.match(r"^([A-Za-z]):[\\/]?(.*)$", path)
    if not m:
        return path
    root = {"c": "/home/user/.wine/drive_c", "z": "", "h": "/mnt/host"}.get(m.group(1).lower())
    if root is None:
        die("drive %s: is not one wcvm knows (C:, Z: or H:)" % m.group(1))
    return root + "/" + m.group(2).replace("\\", "/")


# The guest's end of out.sock, found by the port's name
GUEST_PORT = ('for p in /sys/class/virtio-ports/*; do '
              '[ "$(cat $p/name 2>/dev/null)" = org.wincraft.out ] && port=/dev/${p##*/}; done; ')


def channel_state(q):
    """out.sock as QEMU sees it: whether it took our connection, and whether
    the guest has its end open."""
    port = [c for c in q.cmd("query-chardev")["return"] if c["label"] == "wcout"]
    if not port:
        die("the VM was started without its file channel: restart it (./wcvm restart)")
    return not port[0]["filename"].startswith("disconnected"), bool(port[0].get("frontend-open"))


def channel_connect(q):
    """Connect to out.sock and wait until QEMU has taken the connection: the
    guest reads end of file until then, and its writes are lost. Q: our QMP
    connection, as QEMU takes one at a time."""
    s = socket.socket(socket.AF_UNIX)
    s.connect(sock("out.sock"))
    for _ in range(100):
        if channel_state(q)[0]:
            break
        time.sleep(0.05)
    return s


def channel_read(q, command, size=None, sink=None, timeout=600):
    """Run COMMAND in the VM with its output going to out.sock: SIZE bytes,
    written to SINK, or else a whole PPM image, returned."""
    s = channel_connect(q)
    s.settimeout(timeout)
    got = {"data": bytearray(), "n": 0}

    def reader():
        need = size
        while need is None or got["n"] < need:
            try:
                chunk = s.recv(1 << 20)
            except socket.timeout:
                break
            if not chunk:
                break
            got["n"] += len(chunk)
            if sink:
                sink.write(chunk)
                continue
            buf = got["data"]
            buf += chunk
            if need is None and buf.count(b"\n") >= 3:
                head = bytes(buf).split(b"\n", 3)
                w, h = map(int, head[1].split())
                need = len(buf) - len(head[3]) + w * h * 3

    t = threading.Thread(target=reader)
    t.start()
    serial_sh(GUEST_PORT + command + ' > "$port"', timeout)
    t.join()
    s.close()
    return got["n"] if sink else bytes(got["data"])


def channel_write(q, path, command, timeout=600):
    """Send the file PATH to COMMAND's standard input in the VM; return
    COMMAND's exit status, or None."""
    tag = os.urandom(4).hex()
    s = channel_connect(q)
    try:
        serial_sh("kill $(cat /run/wcvm-channel.pid 2>/dev/null) 2>/dev/null; " + GUEST_PORT +
                  '( (%s) < "$port"; echo $? > /run/wcvm-%s.done ) >/dev/null 2>&1 & echo $! > /run/wcvm-channel.pid'
                  % (command, tag), 10)
        for _ in range(200):            # QEMU drops what arrives before the guest opens its end
            if channel_state(q)[1]:
                break
            time.sleep(0.05)
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                s.sendall(chunk)
        deadline = time.time() + timeout
        while time.time() < deadline:
            out, ok, _ = serial_sh("cat /run/wcvm-%s.done 2>/dev/null" % tag, 10)
            if ok and out.strip().isdigit():
                return int(out.strip())
            time.sleep(0.3)
        return None
    finally:
        s.close()
        serial_sh("rm -f /run/wcvm-%s.done /run/wcvm-channel.pid" % tag, 10)


def write_png(path, width, height, rgb):
    raw = b"".join(b"\0" + rgb[y * width * 3:(y + 1) * width * 3] for y in range(height))

    def chunk(kind, data):
        return (struct.pack(">I", len(data)) + kind + data +
                struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff))

    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" +
                chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) +
                chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def png_size(path):
    with open(path, "rb") as f:
        return struct.unpack(">II", f.read(24)[16:24])


def ppm_to_png(ppm, path):
    try:
        _, dims, _, rgb = ppm.split(b"\n", 3)
        width, height = map(int, dims.split())
        if len(rgb) < width * height * 3:
            raise ValueError("short")
    except ValueError:
        die("no screenshot: the VM sent %d bytes" % len(ppm))
    write_png(path, width, height, rgb)


def xshot_binary():
    """The guest's screenshot program, xshot.c beside this file, compiled on
    this computer since the guest has no compiler; it reads the screen from
    the guest's X server, where QEMU cannot read a 3D display."""
    src, out = os.path.join(APP, "xshot.c"), os.path.join(CACHE, "xshot")
    if os.path.exists(out) and os.path.getmtime(out) >= os.path.getmtime(src):
        return out
    cc = shutil.which("cc") or shutil.which("gcc") or shutil.which("clang")
    if platform.system() != "Linux" or platform.machine() != "x86_64" or not cc:
        die("with 3D graphics, a screenshot needs a C compiler for x86-64 Linux on this computer "
            "(%s); or ./wcvm config graphics=basic, then restart" % (hint("cc") or "gcc and the X11 headers"))
    os.makedirs(CACHE, exist_ok=True)
    r = subprocess.run([cc, "-O2", "-o", out, src, "-lX11"], capture_output=True, text=True)
    if r.returncode:
        die("could not build the screenshot program (%s needs the X11 headers: %s):\n%s"
            % (cc, hint("cc") or "libX11's development files", r.stderr.strip()[-500:]))
    return out


def guest_shot(q, path):
    out, ok, _ = serial_sh("test -x /run/wcvm-xshot && echo present", 10)
    if not ok:
        die("no screenshot: the VM's shell does not answer")
    if "present" not in out:
        binary = xshot_binary()
        size = os.path.getsize(binary)
        # BusyBox head exits with 1 here even when it got everything: check the size
        channel_write(q, binary, "head -c %d > /run/wcvm-xshot.new; [ $(stat -c %%s /run/wcvm-xshot.new) = %d ] && "
                                 "chmod 755 /run/wcvm-xshot.new && mv /run/wcvm-xshot.new /run/wcvm-xshot"
                                 % (size, size), 30)
    ppm_to_png(channel_read(q, "/run/wcvm-xshot", timeout=60), path)


def take_screenshot(q, path):
    r = q.cmd("screendump", filename=path, format="png")
    if "error" in r and "format" in r["error"]["desc"]:         # before QEMU 7.1: PPM only
        r = q.cmd("screendump", filename=path + ".ppm")
        if "error" not in r:
            with open(path + ".ppm", "rb") as f:
                ppm_to_png(f.read(), path)
            os.unlink(path + ".ppm")
    if "error" in r:
        if r["error"]["desc"] != "no surface":
            die("no screenshot: " + r["error"]["desc"])
        guest_shot(q, path)                 # a 3D display: ask the guest's X server


def screen_size(q):
    tmp = os.path.join(RUN, "size.png")
    if "error" not in q.cmd("screendump", filename=tmp, format="png"):
        size = png_size(tmp)
        os.unlink(tmp)
        return size
    out, _, _ = serial_sh("DISPLAY=:0 xrandr 2>/dev/null | "
                          "sed -n 's/.* current \\([0-9]*\\) x \\([0-9]*\\),.*/\\1 \\2/p'", 10)
    try:
        w, h = out.split()[:2]
        return int(w), int(h)
    except ValueError:
        die("cannot tell the VM's screen size")


KEYS = {
    " ": "spc", "\n": "ret", "\t": "tab", "-": "minus", "=": "equal",
    "[": "bracket_left", "]": "bracket_right", ";": "semicolon",
    "'": "apostrophe", "`": "grave_accent", "\\": "backslash", ",": "comma",
    ".": "dot", "/": "slash",
}
SHIFTED = {
    "!": "1", "@": "2", "#": "3", "$": "4", "%": "5", "^": "6", "&": "7",
    "*": "8", "(": "9", ")": "0", "_": "minus", "+": "equal",
    "{": "bracket_left", "}": "bracket_right", ":": "semicolon",
    '"': "apostrophe", "~": "grave_accent", "|": "backslash", "<": "comma",
    ">": "dot", "?": "slash",
}


def press(q, combo, hold=60):
    names = combo.split("-") if len(combo) > 1 else [combo]
    r = q.cmd("send-key", keys=[{"type": "qcode", "data": k} for k in names], **{"hold-time": hold})
    if "error" in r:
        die("%s: %s (key names are QEMU's: ret, esc, tab, spc, ctrl, alt, shift, meta_l, f1, a...)"
            % (combo, r["error"]["desc"]))
    time.sleep(hold / 1000 + 0.05)


def type_text(q, text):
    for ch in text:
        if ch in KEYS:
            press(q, KEYS[ch])
        elif ch in SHIFTED:
            press(q, "shift-" + SHIFTED[ch])
        elif ch.isascii() and ch.isupper():
            press(q, "shift-" + ch.lower())
        elif ch.isascii() and ch.isalnum():
            press(q, ch)
        else:
            die("cannot type %r: only ASCII characters (the VM's keyboard is US)" % ch)
    # QEMU queues the keys faster than the guest takes them: let them arrive
    time.sleep(min(3, 0.05 * len(text)))


def pointer(q, x, y):
    w, h = screen_size(q)
    q.cmd("input-send-event", events=[
        {"type": "abs", "data": {"axis": "x", "value": int(x * 32767 / (w - 1))}},
        {"type": "abs", "data": {"axis": "y", "value": int(y * 32767 / (h - 1))}}])
    time.sleep(0.15)


def click(q, x, y, button="left", count=1):
    pointer(q, x, y)
    for _ in range(count):
        for down in (True, False):
            q.cmd("input-send-event", events=[{"type": "btn", "data": {"down": down, "button": button}}])
            time.sleep(0.08)


def mount_share(cfg):
    """The shared folder at /mnt/host in the VM, and as drive H: of the person's Windows."""
    out, ok, status = serial_sh(
        "mkdir -p /mnt/host && { mountpoint -q /mnt/host || "
        "mount -t 9p -o trans=virtio,version=9p2000.L%s host /mnt/host; } && "
        "%sln -sfn /mnt/host /home/user/.wine/dosdevices/h:"
        % ("" if cfg["share_writable"] else ",ro", AS_USER), 20)
    if not ok or status:
        say("The shared folder could not be mounted: %s" % out.strip())
        return False
    say("Shared folder: %s is drive H: in the VM (%s)."
        % (cfg["share"], "it may change it" if cfg["share_writable"] else "read only"))
    return True


