def load_config(required=True):
    try:
        with open(CONFIG) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        if required:
            die("the VM is not set up yet: ./wcvm doctor, then ./wcvm setup")
        return None
    return dict(DEFAULTS, **cfg)


def save_config(cfg):
    os.makedirs(MACHINE, exist_ok=True)
    with open(CONFIG + ".new", "w") as f:
        json.dump(cfg, f, indent=2, sort_keys=True)
        f.write("\n")
    os.replace(CONFIG + ".new", CONFIG)


class Lock:
    """One wcvm at a time on machine/run/NAME.lock."""

    def __init__(self, name):
        self.path = os.path.join(RUN, name + ".lock")

    def __enter__(self):
        os.makedirs(RUN, exist_ok=True)
        self.f = open(self.path, "w")
        if fcntl:
            fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        self.f.close()


