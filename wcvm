def host_memory_mb():
    try:
        if platform.system() == "Darwin":
            return int(subprocess.run(["sysctl", "-n", "hw.memsize"], capture_output=True,
                                      text=True).stdout) // 1048576
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) // 1024
    except (OSError, ValueError):
        pass
    return None


def recommended():
    mem, cpus = host_memory_mb() or 8192, os.cpu_count() or 2
    return {"mem": 8192 if mem >= 24576 else 4096 if mem >= 8192 else 3072 if mem >= 6144 else 2048,
            "cpus": max(1, min(4, cpus // 2)), "disk_gb": 32}


def kvm_advice():
    """(what is wrong, how to fix it) when the VM has no hardware virtualisation."""
    if platform.system() == "Darwin":
        return ("not available on this Mac: the VM's processor is emulated, many times slower", None)
    if not os.path.exists("/dev/kvm"):
        return ("/dev/kvm is missing: the VM would run many times slower",
                "turn on virtualisation (Intel VT-x, or AMD-V/SVM) in this computer's firmware "
                "settings; inside another virtual machine, enable nested virtualisation")
    if not os.access("/dev/kvm", os.R_OK | os.W_OK):
        try:
            import grp
            group = grp.getgrgid(os.stat("/dev/kvm").st_gid).gr_name
        except (ImportError, KeyError, OSError):
            group = "kvm"
        return ("/dev/kvm is there, but you may not use it: the VM would run many times slower",
                "sudo usermod -aG %s $USER, then log out and back in" % group)
    return ("QEMU has no KVM support", hint("qemu"))


# ---------------------------------------------------------------- releases

def http_get(url, accept="application/vnd.github+json", timeout=30):
    return urllib.request.urlopen(urllib.request.Request(
        url, headers={"User-Agent": "wincraft-vm", "Accept": accept}), timeout=timeout)


def github_release(version=None):
    url = "https://api.github.com/repos/%s/releases/%s" % (REPO, "tags/v" + version if version else "latest")
    with http_get(url, timeout=15) as r:
        return json.load(r)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def iso_version(path):
    m = re.search(r"wincraft-(\d+(?:\.\d+)+)-x86_64\.iso$", os.path.basename(path or ""))
    return m.group(1) if m else ""


def download(version=None):
    """Fetch a release's ISO into machine/downloads, checked against the
    SHA-256 published with it; return (path, version)."""
    try:
        rel = github_release(version)
    except urllib.error.HTTPError as e:
        die("GitHub has no WinCraft OS release %s (%s)" % (version, e.code) if e.code == 404 and version
            else "GitHub answered %s %s" % (e.code, e.reason))
    except (urllib.error.URLError, OSError) as e:
        die("GitHub could not be reached: %s" % getattr(e, "reason", e))
    ver = rel["tag_name"].lstrip("v")
    name = "wincraft-%s-x86_64.iso" % ver
    assets = {a["name"]: a for a in rel.get("assets", [])}
    if name not in assets or name + ".sha256" not in assets:
        die("release %s has no %s with its checksum" % (ver, name))
    os.makedirs(DOWNLOADS, exist_ok=True)
    dest = os.path.join(DOWNLOADS, name)
    try:
        with http_get(assets[name + ".sha256"]["browser_download_url"], "application/octet-stream") as r:
            expected = r.read().decode().split()[0].lower()
        if os.path.exists(dest) and sha256_file(dest) == expected:
            say("WinCraft OS %s is downloaded already, and checked (%s)." % (ver, stored_path(dest)))
            return dest, ver
        size = assets[name]["size"]
        say("Downloading WinCraft OS %s (%d MB) from github.com/%s..." % (ver, size // 1048576, REPO))
        h, got, shown = hashlib.sha256(), 0, 0
        with http_get(assets[name]["browser_download_url"], "application/octet-stream", 60) as r, \
                open(dest + ".part", "wb") as f:
            for chunk in iter(lambda: r.read(1 << 20), b""):
                f.write(chunk)
                h.update(chunk)
                got += len(chunk)
                if got - shown >= size / 10:
                    say("  %d of %d MB" % (got // 1048576, size // 1048576))
                    shown = got
    except (urllib.error.URLError, OSError) as e:
        die("the download failed: %s. Run it again, or download %s by hand and use "
            "./wcvm setup --iso FILE" % (getattr(e, "reason", e), name))
    if h.hexdigest() != expected:
        os.unlink(dest + ".part")
        die("the download does not match the SHA-256 published with it, and was deleted. "
            "Try again; if it happens again, do not use it")
    os.replace(dest + ".part", dest)
    say("It matches the SHA-256 published with it (%s)." % expected)
    return dest, ver


# ---------------------------------------------------------------- QEMU

def sock_dir():
    """Where QEMU's sockets go: machine/run, unless that path is too long for
    a Unix socket (108 bytes on Linux, 104 on macOS)."""
    if len(os.path.join(RUN, "serial.sock")) < 100:
        return RUN
    d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp",
                     "wcvm-%d-%s" % (os.getuid(), hashlib.sha1(APP.encode()).hexdigest()[:10]))
    os.makedirs(d, mode=0o700, exist_ok=True)
    return d


def sock(name):
    return os.path.join(sock_dir(), name)


def opt(value):
    """A file name inside a QEMU option, where a comma is written twice."""
    return value.replace(",", ",,")


def qemu_args(cfg, host, display, live, disk=True):
    """QEMU's command line, and whether the VM gets 3D graphics."""
    width, height = cfg["res"].split("x")
    args = [host.qemu, "-name", "WinCraft OS", "-machine", "q35",
            "-m", str(cfg["mem"]), "-smp", str(cfg["cpus"])]
    if host.accel == "tcg":
        args += ["-accel", "tcg,thread=multi,tb-size=1024", "-cpu", "max"]
    else:
        args += ["-accel", host.accel, "-cpu", "host"]

    gl = display == "window" and cfg["graphics"] == "3d" and host.gl_problem is None
    args += ["-device", "%s,xres=%s,yres=%s" % ("virtio-vga-gl" if gl else "VGA", width, height),
             "-device", "qemu-xhci", "-device", "usb-tablet", "-device", "usb-kbd",
             "-nic", "user,model=virtio-net-pci", "-rtc", "base=utc",
             "-qmp", "unix:%s,server=on,wait=off" % opt(sock("qmp.sock")),
             "-chardev", "socket,id=ser0,path=%s,server=on,wait=off,logfile=%s"
             % (opt(sock("serial.sock")), opt(os.path.join(RUN, "serial.log"))),
             "-serial", "chardev:ser0",
             "-device", "virtio-serial-pci",
             # root shells on the serial port and Ctrl+Alt+F2 (rc.boot), and a
             # fast channel for screenshots and files, where the serial port
             # would stall the guest
             "-smbios", "type=11,value=wincraft.shell",
             "-chardev", "socket,id=wcout,path=%s,server=on,wait=off" % opt(sock("out.sock")),
             "-device", "virtserialport,chardev=wcout,name=org.wincraft.out"]
    if cfg["clipboard"] and "qemu-vdagent" in host.names("chardev"):
        # text only, kept in step by the guest's wcclip
        args += ["-chardev", "qemu-vdagent,id=vdagent,clipboard=on,mouse=off",
                 "-device", "virtserialport,chardev=vdagent,name=com.redhat.spice.0"]

    if cfg["firmware"] == "uefi":
        if not host.uefi:
            die("no UEFI firmware for QEMU on this computer (%s), or ./wcvm config firmware=bios"
                % (hint("uefi") or "install OVMF"))
        code, template, fmt = host.uefi
        if not os.path.exists(VARS):
            shutil.copyfile(template, VARS)
        args += ["-drive", "if=pflash,format=%s,readonly=on,file=%s" % (fmt, opt(code)),
                 "-drive", "if=pflash,format=%s,file=%s" % (fmt, opt(VARS))]

    # live: from the ISO, with the disk beside it to install on, if any
    if live:
        args += ["-drive", "file=%s,media=cdrom,readonly=on,if=none,id=cd0" % opt(real_path(cfg["iso"])),
                 "-device", "ide-cd,drive=cd0,bootindex=1"]
    if disk:
        args += ["-drive", "file=%s,format=qcow2,if=none,id=hd0" % opt(DISK),
                 "-device", "virtio-blk-pci,drive=hd0,bootindex=2"]

    if cfg["share"]:
        if not os.path.isdir(cfg["share"]):
            say("The shared folder %s is missing: the VM starts without it." % cfg["share"])
        elif "virtio-9p-pci" not in host.names("device"):
            say("This QEMU cannot share folders (no virtio-9p-pci): the VM starts without one.")
        else:
            args += ["-virtfs", "local,path=%s,mount_tag=host,security_model=none%s"
                     % (opt(cfg["share"]), "" if cfg["share_writable"] else ",readonly=on")]

    # Game controllers: their input devices, forwarded with the same name and
    # USB ids so that Wine recognises them (an Xbox controller becomes an
    # XInput gamepad). Needs read-write access to /dev/input/eventN, which
    # desktops grant the logged-in user for joysticks.
    if cfg["gamepads"] and host.system == "Linux":
        for pad in glob.glob("/dev/input/by-id/*-event-joystick"):
            dev = os.path.realpath(pad)
            if os.access(dev, os.R_OK | os.W_OK):
                args += ["-device", "virtio-input-host-pci,evdev=%s" % opt(dev)]
                say("Game controller %s: handed to the VM." % os.path.basename(pad))
            else:
                say("Game controller %s: no access to %s, not handed over." % (os.path.basename(pad), dev))

    if display == "window":
        if host.window == "gtk":
            # QEMU 8.1 made the GTK clipboard an option, off by default
            clip = ",clipboard=on" if cfg["clipboard"] and host.version >= (8, 1) else ""
            args += ["-display", "gtk,gl=%s,zoom-to-fit=on%s" % ("on" if gl else "off", clip)]
        elif host.window == "sdl":
            args += ["-display", "sdl,gl=%s" % ("on" if gl else "off")]
        else:
            args += ["-display", host.window]
    else:
        args += ["-display", "none"]
    audio = host.audio if display == "window" and cfg["audio"] else None
    args += ["-audiodev", "%s,id=snd0" % (audio or "none"),
             "-device", "intel-hda", "-device", "hda-output,audiodev=snd0"]
    return args, gl


def cmdline(pid):
    if os.path.isdir("/proc/self"):
        try:
            with open("/proc/%d/cmdline" % pid, "rb") as f:
                return f.read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            return ""
    try:
        return subprocess.run(["ps", "-o", "command=", "-p", str(pid)],
                              capture_output=True, text=True).stdout
    except OSError:
        return ""


def vm_pid():
    """The running VM's QEMU process, or None."""
    try:
        with open(os.path.join(RUN, "qemu.pid")) as f:
            pid = int(f.read())
        os.kill(pid, 0)
    except (OSError, ValueError):
        return None
    # The number may belong to another process by now: ours names this
    # folder's qmp.sock on its command line (and a zombie's is empty).
    return pid if opt(sock("qmp.sock")) in cmdline(pid) else None


def run_state():
    try:
        with open(os.path.join(RUN, "state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def tail(path, lines=20):
    try:
        with open(path, errors="replace") as f:
            return "".join(f.readlines()[-lines:])
    except OSError:
        return ""


def launch(cfg, host, display, live, disk=True):
    """Start QEMU in the background; return its process once QMP answers."""
    os.makedirs(RUN, exist_ok=True)
    for name in ("qmp.sock", "serial.sock", "out.sock"):
        try:
            os.unlink(sock(name))
        except FileNotFoundError:
            pass
    args, gl = qemu_args(cfg, host, display, live, disk)
    log_path = os.path.join(RUN, "qemu.log")
    with open(log_path, "w") as log:
        log.write("# %s\n# %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), " ".join(shlex.quote(a) for a in args)))
        log.flush()
        # a session of its own, and no terminal: it outlives this command
        p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                             cwd=MACHINE, start_new_session=True)
    with open(os.path.join(RUN, "qemu.pid"), "w") as f:
        f.write("%d\n" % p.pid)
    with open(os.path.join(RUN, "state.json"), "w") as f:
        json.dump({"display": display, "live": live, "disk": disk, "graphics": "3d" if gl else "basic",
                   "accel": host.accel, "started": time.time()}, f)
    deadline = time.time() + 60
    while time.time() < deadline:
        if p.poll() is not None:
            die("QEMU stopped as it started:\n" + tail(log_path, 15))
        try:
            QMP(timeout=2).close()
            return p
        except (OSError, ValueError):
            time.sleep(0.3)
    p.kill()
    die("QEMU did not answer within a minute:\n" + tail(log_path, 15))


def wait_gone(pid, timeout):
    deadline = time.time() + timeout
    while time.time() < deadline:
        if vm_pid() != pid:
            return True
        time.sleep(0.5)
    return False


def boot_timeout(host):
    return 1500 if host.accel == "tcg" else 300


class QMP:
    def __init__(self, timeout=10):
        self.s = socket.socket(socket.AF_UNIX)
        self.s.settimeout(timeout)
        try:
            self.s.connect(sock("qmp.sock"))
            self.f = self.s.makefile("rw")
            self.f.readline()               # the greeting
            self.cmd("qmp_capabilities")
        except (OSError, ValueError):
            self.s.close()
            raise

    def cmd(self, name, **args):
        msg = {"execute": name}
        if args:
            msg["arguments"] = args
        self.f.write(json.dumps(msg) + "\n")
        self.f.flush()
        while True:
            line = self.f.readline()
            if not line:
                raise OSError("QEMU closed its QMP connection")
            reply = json.loads(line)
            if "return" in reply or "error" in reply:
                return reply

    def close(self):
        self.s.close()


# ---------------------------------------------------------------- the guest

def serial_sh(command, timeout=60, interrupt=False):
    """Run COMMAND in the VM's serial root shell: (output, finished, status).
    Echo is switched off, so that only real output lies between two markers;
    the markers as typed are followed by other characters than the output's.
    INTERRUPT: send Ctrl+C when the time is up."""
    tag = os.urandom(4).hex()
    begin, end = "WCB" + tag, "WCE" + tag
    pattern = re.compile(begin + r"\n(.*?)" + end + r"(\d+)", re.S)

    def text(buf):      # without carriage returns and colours (BusyBox ls)
        return re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", buf.decode(errors="replace").replace("\r", ""))
    with Lock("serial"):
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(1.0)
        try:
            s.connect(sock("serial.sock"))
        except OSError:
            return "", False, None
        try:
            s.sendall(("\nstty -echo 2>/dev/null; echo %s; ( %s ) </dev/null; echo %s$?\n"
                       % (begin, command, end)).encode())
            buf = b""
            deadline = time.time() + timeout
            while time.time() < deadline:
                try:
                    chunk = s.recv(65536)
                except socket.timeout:
                    continue
                if not chunk:
                    break
                buf += chunk
                m = pattern.search(text(buf))
                if m:
                    return m.group(1).rstrip("\n"), True, int(m.group(2))
            if interrupt:
                s.sendall(b"\x03")
            out = text(buf)
            return out.split(begin + "\n", 1)[1] if begin + "\n" in out else "", False, None
        except OSError:
            return "", False, None
        finally:
            s.close()


def guest_run(command, timeout=60, interrupt=False):
    """serial_sh for any command. The shell reads a line at a time, of at
    most 4095 characters: a long command, one of several lines or one with a
    comment goes to the VM as a script first."""
    if len(command) < 800 and "\n" not in command and "#" not in command:
        return serial_sh(command, timeout, interrupt)
    data = base64.b64encode(command.encode()).decode()
    script = "/run/wcvm-%s" % os.urandom(4).hex()
    for i in range(0, len(data), 800):
        out, ok, _ = serial_sh("printf %%s %s >> %s.b64" % (data[i:i + 800], script), 15)
        if not ok:
            return out, False, None
    return serial_sh("base64 -d %s.b64 > %s; rm -f %s.b64; sh %s; s=$?; rm -f %s; exit $s"
                     % ((script,) * 5), timeout, interrupt)


def shell_up():
    out, ok, _ = serial_sh("echo up", 5)
    return ok and out.strip() == "up"


def desktop_up():
    out, ok, _ = serial_sh("pidof wcshell.exe >/dev/null && DISPLAY=:0 xrandr >/dev/null 2>&1 && echo up", 10)
    return ok and out.strip() == "up"


def wait_for(check, timeout, p=None):
    """Until CHECK() is true; False when the VM stops, or after TIMEOUT."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        if (p.poll() is not None) if p else not vm_pid():
            return False
        if check():
            return True
        time.sleep(2)
    return False


