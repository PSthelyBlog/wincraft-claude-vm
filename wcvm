def hint(what):
    """The usual command that installs WHAT (qemu, uefi, cc) here, or None."""
    if platform.system() == "Darwin":
        return {"qemu": "brew install qemu", "uefi": "brew install qemu"}.get(what)
    for i in os_ids():
        if i in HINTS:
            return HINTS[i][what]
    return None


