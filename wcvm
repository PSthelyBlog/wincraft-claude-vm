def need_shell(timeout=30):
    need_running()
    if not wait_for(shell_up, timeout):
        die("the VM's shell does not answer (still starting? ./wcvm wait shell)")


def need_iso(cfg):
    if not cfg["iso"] or not os.path.isfile(real_path(cfg["iso"])):
        die("no WinCraft OS ISO: ./wcvm download")
    return real_path(cfg["iso"])


def create_disk(cfg, host):
    os.makedirs(MACHINE, exist_ok=True)
    r = subprocess.run([host.qemu_img, "create", "-q", "-f", "qcow2", DISK, "%dG" % cfg["disk_gb"]],
                       capture_output=True, text=True)
    if r.returncode:
        die("could not create the virtual disk: " + r.stderr.strip())


def checks(host, online=True):
    """doctor's findings: dicts of level (ok, warn, fail, info), what, detail, fix."""
    found = []

    def add(level, what, detail, fix=None):
        found.append({"level": level, "what": what, "detail": detail, "fix": fix})

    if host.system not in ("Linux", "Darwin"):
        add("fail", "Operating system", "%s is not supported: WinCraft VM runs on Linux "
            "(and, untested, on macOS)" % host.system)
    if platform.machine().lower() not in ("x86_64", "amd64"):
        add("warn", "Processor", "%s: the VM's x86-64 processor is emulated, many times slower"
            % platform.machine())
    vs = ".".join(map(str, host.version or ()))
    if not host.qemu:
        add("fail", "QEMU", "not installed (qemu-system-x86_64)", hint("qemu"))
    elif not host.version or host.version < MIN_QEMU:
        add("fail", "QEMU", "version %s is too old: %d.%d or newer is needed" % (vs or "?", *MIN_QEMU),
            hint("qemu"))
    else:
        missing = [d for d in ("virtio-net-pci", "virtio-blk-pci", "virtio-serial-pci", "qemu-xhci",
                               "usb-tablet", "VGA", "intel-hda", "ide-cd") if d not in host.names("device")]
        if missing:
            add("fail", "QEMU", "%s lacks devices the VM needs: %s" % (vs, ", ".join(missing)), hint("qemu"))
        else:
            add("ok", "QEMU", "%s (%s)" % (vs, host.qemu))
    if not host.qemu_img:
        add("fail", "qemu-img", "not installed", hint("qemu"))
    if host.qemu and host.version:
        if host.accel != "tcg":
            add("ok", "Hardware virtualisation", {"kvm": "KVM", "hvf": "Hypervisor.framework"}[host.accel])
        else:
            add("warn", "Hardware virtualisation", *kvm_advice())
        if host.window:
            add("ok", "Window", "QEMU's %s display" % host.window.upper())
        elif host.system == "Linux" and not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
            add("warn", "Window", "no graphical session here (no WAYLAND_DISPLAY or DISPLAY): "
                "the VM can only run without a window")
        else:
            add("warn", "Window", "QEMU has no GTK or SDL display: the VM can only run without a window",
                hint("qemu"))
        if host.gl_problem is None:
            add("ok", "3D graphics", "virgl: the VM's OpenGL and Direct3D are drawn by this computer's GPU")
        else:
            add("warn", "3D graphics", "not available, %s: the VM draws in software, fine for "
                "applications, slow for 3D games" % host.gl_problem,
                hint("qemu") if "QEMU" in host.gl_problem else None)
        if host.audio:
            add("ok", "Sound", "through %s" % {"pa": "PulseAudio", "pipewire": "PipeWire",
                                              "coreaudio": "Core Audio"}[host.audio])
        else:
            add("info", "Sound", "no sound server QEMU can use: the VM is silent")
        if "qemu-vdagent" in host.names("chardev"):
            add("ok", "Clipboard", "text is copied and pasted between this computer and the VM")
        else:
            add("info", "Clipboard", "QEMU cannot share the clipboard (no qemu-vdagent)")
        if host.uefi:
            add("ok", "UEFI firmware", host.uefi[0])
        else:
            add("info", "UEFI firmware", "not found; optional, the VM starts with BIOS", hint("uefi"))
    free = shutil.disk_usage(APP).free
    add("ok" if free >= 12e9 else "warn" if free >= 3e9 else "fail", "Free space",
        "%.0f GB here; the ISO takes 0.3 GB and the virtual disk grows as WinCraft OS fills it" % (free / 1e9))
    mem, rec = host_memory_mb(), recommended()
    if mem:
        add("ok" if mem >= 6144 else "warn", "Memory",
            "%.0f GB; the VM would get %.0f GB" % (mem / 1024, rec["mem"] / 1024))
    if online:
        try:
            add("ok", "WinCraft OS releases", "the newest is %s" % github_release()["tag_name"].lstrip("v"))
        except (urllib.error.URLError, OSError, ValueError, KeyError) as e:
            add("warn", "WinCraft OS releases", "GitHub could not be reached (%s)" % getattr(e, "reason", e))
    return found


def cmd_doctor(a):
    host = Host()
    found = checks(host, online=not a.offline)
    rec = recommended()
    rec["graphics"] = "3d" if host.qemu and host.gl_problem is None else "basic"
    ready = not any(c["level"] == "fail" for c in found)
    if a.json:
        say(json.dumps({"ready": ready, "checks": found, "recommended": rec}, indent=2))
        return
    say("WinCraft VM: checking this computer\n")
    mark = {"ok": "✓", "warn": "!", "fail": "✗", "info": "-"}
    for c in found:
        say("  %s %s: %s" % (mark[c["level"]], c["what"], c["detail"]))
        if c["fix"]:
            say("      fix: %s" % c["fix"])
    say("")
    if ready:
        say("Ready. Recommended settings: --mem %d --cpus %d --disk %d --graphics %s"
            % (rec["mem"], rec["cpus"], rec["disk_gb"], rec["graphics"]))
    else:
        say("Not ready: fix what is marked ✗, then run ./wcvm doctor again.")
        sys.exit(1)


def cmd_setup(a):
    host = need_qemu()
    cfg = load_config(False)
    first = cfg is None
    if first:
        cfg = dict(DEFAULTS, **recommended())
        cfg["graphics"] = "3d" if host.gl_problem is None else "basic"
    for key in ("mem", "cpus", "res", "graphics", "display", "firmware"):
        value = getattr(a, key)
        if value is not None:
            try:
                cfg[key] = SETTINGS[key][1](str(value))
            except ValueError as e:
                die("--%s: %s" % (key, e))
    if a.disk is not None:
        if os.path.exists(DISK):
            die("the virtual disk exists already, with %d GB: its size cannot change "
                "(./wcvm destroy deletes it)" % cfg["disk_gb"])
        if not 8 <= a.disk <= 4096:
            die("--disk: from 8 to 4096 GB")
        cfg["disk_gb"] = a.disk
    if cfg["graphics"] == "3d" and host.gl_problem:
        say("No 3D graphics here (%s): the VM draws in software." % host.gl_problem)
        cfg["graphics"] = "basic"
    if cfg["display"] == "window" and not host.window:
        say("No window is possible here: the VM runs without one.")
        cfg["display"] = "headless"
    if cfg["firmware"] == "uefi" and not host.uefi:
        die("no UEFI firmware for QEMU here (%s); leave out --firmware for BIOS" % (hint("uefi") or "install OVMF"))

    if a.iso:
        try:
            cfg["iso"] = _iso(a.iso)
        except ValueError as e:
            die("--iso: %s" % e)
    elif a.version or not cfg["iso"] or not os.path.isfile(real_path(cfg["iso"])):
        path, _ = download(a.version)
        cfg["iso"] = stored_path(path)
    if not os.path.exists(DISK):
        create_disk(cfg, host)
    save_config(cfg)
    say("\nWinCraft VM is set up%s:" % ("" if first else " (settings updated)"))
    say("  WinCraft OS %s, from %s" % (iso_version(cfg["iso"]) or "?", cfg["iso"]))
    say("  %d MB of memory, %d processor cores, a virtual disk of %d GB (it takes only the space used)"
        % (cfg["mem"], cfg["cpus"], cfg["disk_gb"]))
    say("  %s graphics, %s, %s firmware" % ("3D" if cfg["graphics"] == "3d" else "basic",
                                           "in a window" if cfg["display"] == "window" else "no window",
                                           cfg["firmware"].upper()))
    if not cfg["installed"]:
        say("\nNext: ./wcvm install (or ./wcvm start --live to try it first, without installing)")


def cmd_download(a):
    cfg = load_config(False)
    path, ver = download(a.version)
    if cfg is not None and not a.keep:
        cfg["iso"] = stored_path(path)
        save_config(cfg)
        say("The VM installs from, and starts live from, WinCraft OS %s now." % ver)


def cmd_install(a, reinstall=False):
    cfg = load_config()
    host = need_qemu()
    need_stopped()
    if reinstall and not a.yes:
        die("reinstall erases everything on the virtual disk: add --yes")
    if cfg["installed"] and not reinstall:
        die("WinCraft OS %s is installed on the virtual disk already; ./wcvm reinstall --yes "
            "erases the disk and installs again" % cfg["installed_version"])
    iso = need_iso(cfg)
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,16}", a.name):
        die("--name: up to 16 letters, digits, - and _")
    if a.size and not 4096 <= a.size <= cfg["disk_gb"] * 1024:
        die("--size: from 4096 MiB to the disk's %d MiB" % (cfg["disk_gb"] * 1024))
    if a.window and not host.window:
        die("no window is possible here; leave out --window")
    if reinstall and os.path.exists(DISK):
        # A blank disk, rather than the old one beside the ISO: the ISO's
        # start-up would take its partitions, found by their labels, as its own.
        os.unlink(DISK)
        cfg.update(installed=False, installed_version="", snapshots={})
        save_config(cfg)
        say("The virtual disk was erased, with its snapshots.")
    if not os.path.exists(DISK):
        create_disk(cfg, host)

    say("Starting WinCraft OS %s from its ISO%s..." % (iso_version(iso), " in a window" if a.window else ""))
    p = launch(cfg, host, "window" if a.window else "headless", live=True)

    def fail(msg):
        shot = os.path.join(SHOTS, time.strftime("install-failed-%Y%m%d-%H%M%S.png"))
        try:
            os.makedirs(SHOTS, exist_ok=True)
            q = QMP()
            take_screenshot(q, shot)
            q.cmd("quit")
            msg += "\nThe VM's screen at that moment: %s" % shot
        except (OSError, ValueError, SystemExit):
            p.kill()
        die(msg + "\nThe VM was powered off.")

    if not wait_for(shell_up, boot_timeout(host), p):
        fail("WinCraft OS did not start from the ISO (its shell never answered)")
    out, ok, _ = serial_sh("test -e /run/wincraft/live && test -f /live/medium/wincraft/system.sfs && "
                           "cat /etc/wincraft/version /sys/block/%s/size" % GUEST_DISK, 15)
    fields = out.split()
    if not ok or len(fields) != 2:
        fail("the VM did not start from the ISO as expected: %s" % out.strip())
    version = fields[0]
    say("Installing WinCraft OS %s on the virtual disk (%d GB)..."
        % (version, round((a.size * 1048576 if a.size else int(fields[1]) * 512) / 2**30)))
    lines = guest_request("install", "%s %d %s" % (GUEST_DISK, a.size, a.name), 1800)
    if lines[-1] != "done":
        fail("the installer stopped: %s" % lines[-1])
    cfg.update(installed=True, installed_version=version)
    save_config(cfg)
    say("Installed. Shutting the VM down...")
    serial_sh("poweroff", 5)
    try:
        p.wait(120)
    except subprocess.TimeoutExpired:
        QMP().cmd("quit")
        p.wait(20)
    say("WinCraft OS %s is installed on the virtual disk. ./wcvm start starts it." % version)


def cmd_start(a):
    cfg = load_config()
    host = need_qemu()
    if vm_pid():
        say("The VM is running already.")
    else:
        if not os.path.exists(DISK):
            die("the virtual disk is missing: ./wcvm setup")
        live = a.live or not cfg["installed"]
        if live:
            need_iso(cfg)
        display = "headless" if a.headless else "window" if a.window else cfg["display"]
        if display == "window" and not host.window:
            say("No window is possible here: the VM starts without one.")
            display = "headless"
        # Live beside an installed disk, the ISO's start-up would take the
        # disk's partitions, found by their labels, as its own: leave it out.
        launch(cfg, host, display, live, disk=not (live and cfg["installed"]))
        if live and not cfg["installed"]:
            say("WinCraft OS is not installed yet: it starts live from its ISO, and nothing is kept "
                "when it stops (./wcvm install installs it).")
        elif live:
            say("Starting live from the ISO, without the virtual disk: the installed system is left "
                "alone, and nothing is kept.")
        say("The VM is starting%s." % (" in a window" if display == "window" else ", without a window"))
    if a.wait:
        if not wait_for(desktop_up, boot_timeout(host)):
            die("the desktop did not come up: ./wcvm screenshot shows the screen, and "
                "./wcvm sh 'tail /run/log/desktop.log' the desktop's log once the shell answers")
        say("WinCraft OS is up, with its desktop.")
        remember(cfg, guest_info())
        if cfg["share"]:
            mount_share(cfg)


def cmd_stop(a):
    pid = vm_pid()
    if not pid:
        say("The VM is not running.")
        return
    if a.force:
        try:
            QMP().cmd("quit")
        except (OSError, ValueError):
            os.kill(pid, 15)
        wait_gone(pid, 20)
        say("The VM was powered off.")
        return
    info = guest_info()
    if info is None:
        die("the VM's shell does not answer: ./wcvm stop --force powers it off at once, like pulling the plug")
    say("Shutting WinCraft OS down...")
    if info.get("desktop") == "yes":
        # as Start > Shut down does: every program may save its work first
        serial_sh(AS_USER + "setsid /usr/lib/wincraft/end-session poweroff >/dev/null 2>&1 &", 10)
    else:
        serial_sh("poweroff", 5)
    if wait_gone(pid, a.timeout):
        say("The VM is off.")
        return
    die("WinCraft OS has not shut down after %d seconds: a program may be asking to save its work "
        "(./wcvm screenshot shows it). ./wcvm stop --force powers it off at once." % a.timeout)


def cmd_restart(a):
    state = run_state()
    if vm_pid():
        a.force = False
        cmd_stop(a)
    a.live = bool(state.get("live"))
    if not a.window and not a.headless and state.get("display"):
        a.window, a.headless = state["display"] == "window", state["display"] == "headless"
    cmd_start(a)


def cmd_wait(a):
    need_running()
    check = desktop_up if a.what == "desktop" else shell_up
    if not wait_for(check, a.timeout):
        die("the %s is not up after %d seconds" % (a.what, a.timeout))
    say("The %s is up." % a.what)


def cmd_status(a):
    cfg = load_config(False)
    host = Host()
    pid = vm_pid()
    state = run_state() if pid else {}
    info = guest_info(4) if pid else None
    if cfg is not None:
        remember(cfg, info)
    snaps = sorted(cfg["snapshots"]) if cfg else []
    st = {
        "configured": cfg is not None,
        "qemu": bool(host.qemu and host.qemu_img),
        "running": bool(pid),
        "settings": {k: cfg[k] for k in SETTINGS} if cfg else None,
        "disk_gb": cfg["disk_gb"] if cfg else None,
        "disk_used_gb": round(os.stat(DISK).st_blocks * 512 / 1e9, 1) if os.path.exists(DISK) else None,
        "installed": cfg["installed"] if cfg else False,
        "installed_version": cfg["installed_version"] if cfg else "",
        "iso_version": iso_version(cfg["iso"]) if cfg else "",
        "run": state or None,
        "guest": info,
        "snapshots": snaps,
    }
    if a.json:
        say(json.dumps(st, indent=2))
        return
    if cfg is None:
        say("WinCraft VM is not set up yet: ./wcvm doctor, then ./wcvm setup.")
        if not st["qemu"]:
            say("QEMU is not installed on this computer.")
        return
    say("WinCraft VM")
    say("  system:   %s" % ("WinCraft OS %s, installed on the virtual disk" % cfg["installed_version"]
                            if cfg["installed"] else "not installed yet (ISO: WinCraft OS %s)" % st["iso_version"]))
    if pid:
        how = "in a window" if state.get("display") == "window" else "without a window"
        say("  running:  yes, %s, %s graphics%s%s" % (
            how, "3D" if state.get("graphics") == "3d" else "basic",
            ", live from the ISO (nothing is kept)" if state.get("live") else "",
            ", without KVM (slow)" if state.get("accel") == "tcg" else ""))
        if info:
            say("  guest:    WinCraft OS %s, %s session, desktop %s, network %s, up %d min"
                % (info.get("version", "?"), info.get("session"),
                   "running" if info.get("desktop") == "yes" else "not running yet",
                   info.get("ip") or "down", int(info.get("uptime") or 0) // 60))
        else:
            say("  guest:    starting (its shell does not answer yet)")
    else:
        say("  running:  no")
    say("  settings: %d MB, %d cores, %s graphics, %s, %s" % (
        cfg["mem"], cfg["cpus"], cfg["graphics"], cfg["display"], cfg["firmware"]))
    if st["disk_used_gb"] is not None:
        say("  disk:     %d GB, %.1f GB used on this computer" % (cfg["disk_gb"], st["disk_used_gb"]))
    if cfg["share"]:
        say("  shared:   %s as drive H:%s" % (cfg["share"], "" if cfg["share_writable"] else " (read only)"))
    if snaps:
        say("  snapshots: %s" % ", ".join(snaps))


def cmd_screenshot(a):
    need_running()
    path = os.path.abspath(a.file) if a.file else \
        os.path.join(SHOTS, time.strftime("screen-%Y%m%d-%H%M%S.png"))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    q = QMP()
    take_screenshot(q, path)
    q.close()
    say("%s (%dx%d)" % (path, *png_size(path)))
    old = sorted(glob.glob(os.path.join(SHOTS, "screen-*.png")))[:-30]
    for f in old:
        os.unlink(f)


def cmd_sh(a):
    need_shell()
    command = " ".join(a.command)
    if not command.strip():
        die("which command?")
    if a.user:
        command = AS_USER + "sh -c " + shlex.quote(command)
    out, ok, status = guest_run(command, a.timeout, interrupt=True)
    if out:
        say(out)
    if not ok:
        die("no answer after %d seconds: interrupted. Start long commands in the background "
            "(setsid ... &), or give --timeout" % a.timeout, 124)
    sys.exit(status)


def cmd_push(a):
    need_shell()
    if not os.path.isfile(a.file):
        die("no such file here: %s" % a.file)
    dest = guest_path(a.dest)
    out, _, _ = serial_sh("test -d %s && echo folder" % shlex.quote(dest), 10)
    if dest.endswith("/") or out.strip() == "folder":
        dest = dest.rstrip("/") + "/" + os.path.basename(a.file)
    size = os.path.getsize(a.file)
    qd = shlex.quote(dest)
    # under the person's home, written as them, folders included
    write = 'mkdir -p "$(dirname %s)" && cat > %s.part' % (qd, qd)
    if dest.startswith("/home/user/"):
        write = AS_USER + "sh -c " + shlex.quote(write)
    q = QMP()
    channel_write(q, a.file, "head -c %d | %s" % (size, write), timeout=max(60, size // 2000000))
    q.close()
    out, ok, status = serial_sh("[ \"$(stat -c %%s %s.part 2>/dev/null)\" = %d ] && mv %s.part %s"
                                % (qd, size, qd, qd), 15)
    if not ok or status:
        serial_sh("rm -f %s.part" % qd, 10)
        die("the copy did not arrive whole")
    say("Copied to %s in the VM (%d bytes)." % (dest, size))


def cmd_pull(a):
    need_shell()
    src = guest_path(a.src)
    out, ok, status = serial_sh("stat -c %%s %s" % shlex.quote(src), 10)
    if not ok or status or not out.strip().isdigit():
        die("no such file in the VM: %s" % src)
    size = int(out.strip())
    dest = os.path.join(a.dest, os.path.basename(src)) if os.path.isdir(a.dest) else a.dest
    q = QMP()
    with open(dest + ".part", "wb") as f:
        got = channel_read(q, "cat %s" % shlex.quote(src), size=size, sink=f,
                           timeout=max(60, size // 2000000))
    q.close()
    if got != size:
        os.unlink(dest + ".part")
        die("the copy did not arrive whole (%d of %d bytes)" % (got, size))
    os.replace(dest + ".part", dest)
    say("Copied to %s (%d bytes)." % (os.path.abspath(dest), size))


def cmd_input(a):
    need_running()
    q = QMP()
    if a.cmd == "type":
        type_text(q, a.text)
    elif a.cmd == "key":
        for combo in a.combos:
            press(q, combo)
    elif a.cmd == "move":
        pointer(q, a.x, a.y)
    elif a.cmd == "click":
        click(q, a.x, a.y, a.button)
    elif a.cmd == "dclick":
        click(q, a.x, a.y, count=2)
    q.close()


def cmd_config(a):
    cfg = load_config()
    if not a.settings:
        for key, (desc, _) in SETTINGS.items():
            value = cfg[key]
            shown = ("on" if value else "off") if isinstance(value, bool) else str(value) or "(none)"
            say("  %-15s %-14s %s" % (key, shown, desc))
        say("  %-15s %-14s %s" % ("disk_gb", cfg["disk_gb"], "the virtual disk's size (fixed when it is made)"))
        say("\nChange with ./wcvm config KEY=VALUE; changes take effect at the next start.")
        return
    host = Host()
    changes = {}
    for item in a.settings:
        key, sep, value = item.partition("=")
        if not sep or key not in SETTINGS:
            die("not a setting: %s (one of %s)" % (item, ", ".join(SETTINGS)))
        try:
            changes[key] = SETTINGS[key][1](value)
        except ValueError as e:
            die("%s: %s" % (key, e))
    if changes.get("firmware") == "uefi" and not host.uefi:
        die("no UEFI firmware for QEMU here (%s)" % (hint("uefi") or "install OVMF"))
    if changes.get("graphics") == "3d" and host.gl_problem:
        say("Note: no 3D graphics here (%s): the VM keeps drawing in software." % host.gl_problem)
    if changes.get("display") == "window" and not host.window:
        say("Note: no window is possible here: the VM keeps running without one.")
    mem = host_memory_mb()
    if "mem" in changes and mem and changes["mem"] > mem * 3 // 4:
        say("Note: that is most of this computer's %d MB." % mem)
    cfg.update(changes)
    save_config(cfg)
    for key, value in changes.items():
        say("%s = %s" % (key, ("on" if value else "off") if isinstance(value, bool) else value or "(none)"))
    if vm_pid():
        say("The VM is running: this takes effect at its next start (./wcvm restart).")


def cmd_share(a):
    cfg = load_config()
    if not cfg["share"]:
        die("no shared folder: ./wcvm config share=FOLDER, then restart the VM")
    need_shell()
    out, _, _ = serial_sh("ls /sys/bus/virtio/drivers/9pnet_virtio/ 2>/dev/null | grep -c virtio", 10)
    if out.strip() in ("", "0"):
        die("the VM was started without the shared folder: restart it (./wcvm restart)")
    mount_share(cfg)


def qemu_img_snapshots(host):
    r = subprocess.run([host.qemu_img, "snapshot", "-l", "-U", DISK], capture_output=True, text=True)
    names = []
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) > 2 and parts[0].isdigit():
            names.append(parts[1])
    return names


def cmd_snapshot(a):
    cfg = load_config()
    host = need_qemu()
    if not os.path.exists(DISK):
        die("there is no virtual disk")
    names = qemu_img_snapshots(host)
    if a.action == "list":
        if not names:
            say("No snapshots. ./wcvm snapshot save NAME takes one (with the VM stopped).")
        for n in names:
            meta = cfg["snapshots"].get(n, {})
            what = ("WinCraft OS %s" % meta["version"] if meta.get("installed")
                    else "before WinCraft OS was installed" if meta else "")
            say("  %-20s %s  %s" % (n, meta.get("date", ""), what))
        return
    if not a.name or not re.fullmatch(r"[A-Za-z0-9._-]{1,40}", a.name):
        die("a snapshot needs a name: letters, digits, '.', '-' and '_'")
    need_stopped()
    if a.action == "save":
        if a.name in names:
            die("there is a snapshot %s already" % a.name)
        args = ["-c", a.name]
    elif a.name not in names:
        die("no snapshot %s (./wcvm snapshot list)" % a.name)
    elif not a.yes:
        die("%s: add --yes (%s)" % (a.action, "everything changed since the snapshot is lost"
                                    if a.action == "restore" else "it cannot be undone"))
    else:
        args = ["-a" if a.action == "restore" else "-d", a.name]
    r = subprocess.run([host.qemu_img, "snapshot"] + args + [DISK], capture_output=True, text=True)
    if r.returncode:
        die(r.stderr.strip())
    if a.action == "save":
        cfg["snapshots"][a.name] = {"date": time.strftime("%Y-%m-%d %H:%M"), "installed": cfg["installed"],
                                    "version": cfg["installed_version"]}
        say("Snapshot %s saved: ./wcvm snapshot restore %s --yes brings the disk back to now." % (a.name, a.name))
    elif a.action == "restore":
        meta = cfg["snapshots"].get(a.name)
        if meta:
            cfg.update(installed=meta["installed"], installed_version=meta["version"])
        say("The virtual disk is back as it was at snapshot %s." % a.name)
    else:
        cfg["snapshots"].pop(a.name, None)
        say("Snapshot %s deleted." % a.name)
    save_config(cfg)


def cmd_update(a):
    cfg = load_config()
    need_shell()
    info = guest_info(10) or {}
    if info.get("session") != "installed":
        die("this session runs live from the ISO: there is nothing to update. "
            "Install WinCraft OS, or start a newer ISO (./wcvm download)")
    lines = guest_request("update", "check", 120, show=False)
    if lines[-1].startswith("error: "):
        die(lines[-1][7:])
    found = dict(line.split(" ", 1) for line in lines if " " in line)
    installed, latest = found.get("installed", "?"), found.get("latest", "")
    if a.action == "check":
        say("WinCraft OS %s is installed; the newest release is %s." % (installed, latest or "unknown"))
        if found.get("next"):
            say("WinCraft OS %s is installed for the next start." % found["next"])
        if found.get("previous"):
            say("%s is kept as the previous version%s." % (found["previous"], ", offered in the boot menu"
                                                          if found.get("previous-boot") == "yes" else ""))
        if latest and latest != installed and found.get("next") != latest:
            say("An update is available: ./wcvm update install")
        return
    if a.action == "install":
        if found.get("next") == latest:
            say("WinCraft OS %s is installed already and starts at the next start (./wcvm restart)." % latest)
            return
        if not latest or latest == installed:
            say("WinCraft OS %s is the newest release: nothing to do." % installed)
            return
        say("Updating WinCraft OS %s to %s (a download of about 270 MB, inside the VM)..." % (installed, latest))
        args = "install " + latest
    else:
        if not found.get("previous"):
            die("there is no previous version to go back to")
        say("Going back to WinCraft OS %s at the next start..." % found["previous"])
        args = "previous"
    lines = guest_request("update", args, 3600)
    if lines[-1] != "done":
        die(lines[-1][7:] if lines[-1].startswith("error: ") else lines[-1])
    say("Done: it takes effect when the VM restarts (./wcvm restart).")


def cmd_logs(a):
    path = os.path.join(RUN, "qemu.log" if a.which == "qemu" else "serial.log")
    text = tail(path, a.lines)
    # the serial log holds the terminal's control sequences
    say(re.sub(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b[()][A-Z0-9]|[\x00-\x08\x0e-\x1f]", "", text) or "(empty)")


def cmd_destroy(a):
    need_stopped()
    if not os.path.isdir(MACHINE):
        say("There is no VM to delete.")
        return
    if not a.yes:
        die("destroy deletes the virtual disk, with everything installed in the VM, and its settings: add --yes")
    if a.all:
        shutil.rmtree(MACHINE, ignore_errors=True)
        say("The VM and its downloads are deleted.")
        return
    for path in (DISK, CONFIG, VARS):
        if os.path.exists(path):
            os.unlink(path)
    for d in (RUN, SHOTS, CACHE):
        shutil.rmtree(d, ignore_errors=True)
    say("The VM is deleted; the downloads are kept (./wcvm setup starts again).")


def describe(cfg, pid, state):
    """The VM's state in a few lines, for Claude at the start of a session."""
    if cfg is None:
        host = Host()
        return ("WinCraft VM state: NOT SET UP - this is the first launch%s. As soon as the person "
                "writes anything (even just hello), greet them in a sentence or two and guide them "
                "through the setup: follow the `setup` skill."
                % ("" if host.qemu else ", and QEMU is not installed on this computer"))
    lines = ["WinCraft VM state: set up."]
    lines.append("WinCraft OS %s is installed on the virtual disk." % cfg["installed_version"] if cfg["installed"]
                 else "WinCraft OS is NOT installed yet (ISO: WinCraft OS %s): offer to install it "
                      "(the `setup` skill, from its install step)." % (iso_version(cfg["iso"]) or "?"))
    if pid:
        lines.append("The VM is running%s%s." % (" in a window" if state.get("display") == "window" else
                                                 " without a window",
                                                 ", live from the ISO" if state.get("live") else ""))
    else:
        lines.append("The VM is stopped.")
    lines.append("Settings: %d MB, %d cores, %s graphics, %s, %s firmware%s." % (
        cfg["mem"], cfg["cpus"], cfg["graphics"], cfg["display"], cfg["firmware"],
        ", shared folder %s" % cfg["share"] if cfg["share"] else ""))
    return " ".join(lines)


def cmd_hook(a):
    """SessionStart hook for Claude Code: the state as context, and a
    welcome for the person the first time."""
    try:
        source = "startup" if sys.stdin.isatty() else json.load(sys.stdin).get("source", "startup")
    except (ValueError, AttributeError):
        source = "startup"
    cfg = load_config(False)
    pid = vm_pid()
    out = {"hookSpecificOutput": {"hookEventName": "SessionStart",
                                  "additionalContext": describe(cfg, pid, run_state() if pid else {})}}
    if cfg is None and source == "startup":
        out["systemMessage"] = ("Welcome to WinCraft VM. Nothing is set up yet: say hello, and Claude will "
                                "check this computer, then install WinCraft OS in a virtual machine for you.")
    say(json.dumps(out))


def cmd_statusline(a):
    """Claude Code's status line: one line, quickly (no question to the VM)."""
    if not sys.stdin.isatty():
        sys.stdin.read()
    cfg = load_config(False)
    if cfg is None:
        say("WinCraft VM · not set up yet")
        return
    pid = vm_pid()
    state = run_state() if pid else {}
    running = "\033[32m● running\033[0m" + (" live" if state.get("live") else "") if pid else "\033[2m○ stopped\033[0m"
    system = "WinCraft OS %s" % cfg["installed_version"] if cfg["installed"] else "not installed"
    say("WinCraft VM %s · %s · %g GB · %d cores" % (running, system, cfg["mem"] / 1024, cfg["cpus"]))


def main():
    p = argparse.ArgumentParser(prog="wcvm", description="The WinCraft OS virtual machine of this folder.",
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = p.add_subparsers(dest="cmd", metavar="COMMAND")

    s = sub.add_parser("doctor", help="can this computer run the VM?")
    s.add_argument("--json", action="store_true")
    s.add_argument("--offline", action="store_true", help="do not ask GitHub for the newest release")
    s.set_defaults(func=cmd_doctor)

    s = sub.add_parser("setup", help="settings, download, virtual disk")
    s.add_argument("--mem", type=int)
    s.add_argument("--cpus", type=int)
    s.add_argument("--disk", type=int, help="the virtual disk's size, GB")
    s.add_argument("--res")
    s.add_argument("--graphics", choices=["3d", "basic"])
    s.add_argument("--display", choices=["window", "headless"])
    s.add_argument("--firmware", choices=["bios", "uefi"])
    g = s.add_mutually_exclusive_group()
    g.add_argument("--iso", help="a WinCraft OS ISO of this computer instead of a download")
    g.add_argument("--version", help="this release instead of the newest")
    s.set_defaults(func=cmd_setup)

    s = sub.add_parser("download", help="a WinCraft OS ISO, checked")
    s.add_argument("--version")
    s.add_argument("--keep", action="store_true", help="keep the VM's ISO setting as it is")
    s.set_defaults(func=cmd_download)

    for name in ("install", "reinstall"):
        s = sub.add_parser(name, help="install WinCraft OS on the virtual disk" if name == "install"
                           else "erase the virtual disk and install again")
        s.add_argument("--size", type=int, default=0, help="MiB for WinCraft (default: the whole disk)")
        s.add_argument("--name", default="WINCRAFT_DATA", help="the data partition's label")
        s.add_argument("--window", action="store_true", help="show the VM while it installs")
        s.add_argument("--yes", action="store_true")
        s.set_defaults(func=(lambda a: cmd_install(a, reinstall=True)) if name == "reinstall" else cmd_install)

    for name in ("start", "restart"):
        s = sub.add_parser(name, help="start the VM" if name == "start" else "shut down and start again")
        g = s.add_mutually_exclusive_group()
        g.add_argument("--window", action="store_true")
        g.add_argument("--headless", action="store_true")
        if name == "start":
            s.add_argument("--live", action="store_true", help="from the ISO, leaving the disk alone")
        s.add_argument("--wait", action="store_true", help="until the desktop is up")
        if name == "restart":
            s.add_argument("--timeout", type=int, default=120, help="for the shutdown")
        s.set_defaults(func=cmd_start if name == "start" else cmd_restart)

    s = sub.add_parser("stop", help="shut the VM down")
    s.add_argument("--force", action="store_true", help="power off at once")
    s.add_argument("--timeout", type=int, default=120)
    s.set_defaults(func=cmd_stop)

    s = sub.add_parser("wait", help="until the shell or the desktop is up")
    s.add_argument("what", nargs="?", choices=["shell", "desktop"], default="desktop")
    s.add_argument("--timeout", type=int, default=300)
    s.set_defaults(func=cmd_wait)

    s = sub.add_parser("status", help="the VM's state")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("screenshot", help="the VM's screen as PNG")
    s.add_argument("file", nargs="?")
    s.set_defaults(func=cmd_screenshot)

    s = sub.add_parser("sh", help="run a command in the VM")
    s.add_argument("--user", action="store_true", help="as the person, with their desktop's environment")
    s.add_argument("--timeout", type=int, default=60)
    s.add_argument("command", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_sh)

    s = sub.add_parser("push", help="copy a file into the VM")
    s.add_argument("file")
    s.add_argument("dest")
    s.set_defaults(func=cmd_push)

    s = sub.add_parser("pull", help="copy a file out of the VM")
    s.add_argument("src")
    s.add_argument("dest")
    s.set_defaults(func=cmd_pull)

    s = sub.add_parser("type", help="type text")
    s.add_argument("text")
    s.set_defaults(func=cmd_input)
    s = sub.add_parser("key", help="press keys, e.g. ctrl-alt-delete")
    s.add_argument("combos", nargs="+")
    s.set_defaults(func=cmd_input)
    for name in ("move", "click", "dclick"):
        s = sub.add_parser(name, help="the pointer, in screenshot pixels")
        s.add_argument("x", type=int)
        s.add_argument("y", type=int)
        if name == "click":
            s.add_argument("button", nargs="?", choices=["left", "right", "middle"], default="left")
        s.set_defaults(func=cmd_input)

    s = sub.add_parser("config", help="show or change settings")
    s.add_argument("settings", nargs="*", metavar="KEY=VALUE")
    s.set_defaults(func=cmd_config)

    s = sub.add_parser("share", help="mount the shared folder now")
    s.set_defaults(func=cmd_share)

    s = sub.add_parser("snapshot", help="snapshots of the virtual disk")
    s.add_argument("action", nargs="?", choices=["list", "save", "restore", "delete"], default="list")
    s.add_argument("name", nargs="?")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(func=cmd_snapshot)

    s = sub.add_parser("update", help="WinCraft OS's updater, in the VM")
    s.add_argument("action", nargs="?", choices=["check", "install", "previous"], default="check")
    s.set_defaults(func=cmd_update)

    s = sub.add_parser("logs", help="QEMU's output, or the transcript of the VM's serial shell")
    s.add_argument("which", nargs="?", choices=["qemu", "serial"], default="qemu")
    s.add_argument("-n", "--lines", type=int, default=40)
    s.set_defaults(func=cmd_logs)

    s = sub.add_parser("destroy", help="delete the VM")
    s.add_argument("--yes", action="store_true")
    s.add_argument("--all", action="store_true", help="the downloads too")
    s.set_defaults(func=cmd_destroy)

    s = sub.add_parser("hook")
    s.add_argument("event", choices=["session-start"])
    s.set_defaults(func=cmd_hook)
    s = sub.add_parser("statusline")
    s.set_defaults(func=cmd_statusline)

    a = p.parse_args()
    if not a.cmd:
        p.print_help()
        return
    try:
        a.func(a)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
