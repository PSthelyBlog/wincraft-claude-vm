def say(*args):
    try:
        print(*args, flush=True)
    except BrokenPipeError:
        # the reader went away (| head): finish the job without output
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())


def die(msg, code=1):
    print("wcvm: " + msg, file=sys.stderr, flush=True)
    sys.exit(code)


def stored_path(path):
    """PATH relative to this folder when it is inside, so that the folder can move."""
    rel = os.path.relpath(path, APP)
    return path if rel.startswith("..") else rel


def real_path(path):
    return path if os.path.isabs(path) else os.path.join(APP, path)


# ---------------------------------------------------------------- settings

def _number(lo, hi):
    def parse(v):
        if not re.fullmatch(r"\d+", v) or not lo <= int(v) <= hi:
            raise ValueError("a whole number from %d to %d" % (lo, hi))
        return int(v)
    return parse


def _choice(*values):
    def parse(v):
        if v not in values:
            raise ValueError(" or ".join(values))
        return v
    return parse


def _bool(v):
    if v.lower() in ("on", "yes", "true", "1"):
        return True
    if v.lower() in ("off", "no", "false", "0"):
        return False
    raise ValueError("on or off")


def _res(v):
    m = re.fullmatch(r"(\d{3,4})x(\d{3,4})", v)
    if not m or int(m.group(1)) < 800 or int(m.group(2)) < 600:
        raise ValueError("WIDTHxHEIGHT, at least 800x600")
    return v


def _folder(v):
    if v == "":
        return ""
    path = os.path.realpath(os.path.expanduser(v))
    if not os.path.isdir(path):
        raise ValueError("a folder of this computer (no such folder: %s)" % path)
    return path


def _iso(v):
    path = os.path.realpath(os.path.expanduser(v))
    if not os.path.isfile(path):
        raise ValueError("an ISO file (not found: %s)" % path)
    return stored_path(path)


